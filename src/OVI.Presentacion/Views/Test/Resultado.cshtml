@model Resultado
@{
    ViewData["Title"] = "Mi resultado vocacional";
    var areas = new[] { ("Realista", Model.PuntajeR), ("Investigador", Model.PuntajeI), ("Artístico", Model.PuntajeA), ("Social", Model.PuntajeS), ("Emprendedor", Model.PuntajeE), ("Convencional", Model.PuntajeC) };
    var maximo = Math.Max(1, areas.Max(a => a.Item2));
}
<div id="resultado-pdf">
<div class="section-heading">
    <div><h1 class="h2 mb-0">¡Tus resultados están listos!</h1></div>
    <button id="btnPdf" class="btn btn-outline-secondary" type="button" data-no-pdf>Guardar como PDF</button>
</div>
<section class="hero p-4 p-md-5 mb-4" style="display:block">
    <span class="eyebrow">Tu perfil dominante</span>
    <h2 class="display-5 mt-3" style="overflow-wrap:anywhere">@Model.PerfilDominante</h2>
    <p class="mb-0">Este resultado resume las áreas con mayor puntuación. No determina por sí solo qué carrera debes estudiar.</p>
</section>
<h2 class="h4 mb-3">Tus intereses por área</h2>
<div class="row g-3 mb-5">
    @foreach (var a in areas)
    {
        <div class="col-md-6">
            <div class="card card-body h-100">
                <div class="d-flex justify-content-between mb-2"><strong>@a.Item1</strong><span class="text-muted">@a.Item2 puntos</span></div>
                <div class="progress" role="progressbar" aria-label="@a.Item1" aria-valuenow="@a.Item2" aria-valuemin="0" aria-valuemax="@maximo"><div class="progress-bar" style="width:@(100.0 * a.Item2 / maximo)%"></div></div>
            </div>
        </div>
    }
</div>
<h2 class="h4 mb-3">Carreras más compatibles con tu perfil</h2>
<div class="nota-box">
    <strong>Nota importante</strong>
    Estas carreras se sugieren porque coinciden con tu perfil. No representan una obligación, solo una aproximación para ayudarte a explorar opciones académicas. Compara planes de estudio, costos, requisitos y oportunidades.
</div>
<div class="row g-3 mb-4">
    @foreach (var r in Model.Recomendaciones.OrderBy(x => x.Posicion))
    {
        <div class="col-md-4">
            <article class="recomendacion">
                <span class="pos">@(r.Posicion)ª recomendación</span>
                <h3>@r.Carrera?.Nombre</h3>
                <p>@r.Carrera?.Descripcion</p>
                <span class="badge text-bg-light">@r.Carrera?.Tipo</span>
                <p class="small text-muted mt-3 mb-0">Afinidad orientativa: @r.NivelAfinidad%</p>
            </article>
        </div>
    }
</div>
</div>
<p data-no-pdf class="mt-2"><strong>¿Tienes dudas sobre lo que significan tus resultados?</strong> Saviox, nuestro asistente, puede ayudarte a analizarlos y explorar tus opciones.</p>
<a class="btn btn-primary" data-no-pdf asp-controller="Chatbot" asp-action="Contextual">Chatear con mi asesor vocacional</a>
<a class="btn btn-outline-primary" data-no-pdf asp-controller="Test" asp-action="Historial">Ver historial</a>
@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
document.getElementById('btnPdf').addEventListener('click', function () {
    var btn = this;
    if (typeof html2pdf === 'undefined') { window.print(); return; }
    btn.disabled = true; btn.textContent = 'Generando PDF…';
    html2pdf().set({
        margin: [10, 10, 10, 10],
        filename: 'VocalO-resultado.pdf',
        image: { type: 'jpeg', quality: 0.95 },
        html2canvas: { scale: 2, backgroundColor: '#FFF2E1', ignoreElements: function (el) { return el.hasAttribute && el.hasAttribute('data-no-pdf'); } },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'], avoid: ['.card', '.recomendacion', '.nota-box'] }
    }).from(document.getElementById('resultado-pdf')).save().then(function () {
        btn.disabled = false; btn.textContent = 'Guardar como PDF';
    }).catch(function () { btn.disabled = false; btn.textContent = 'Guardar como PDF'; });
});
</script>
}
