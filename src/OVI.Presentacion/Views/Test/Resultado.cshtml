@model Resultado
@{ViewData["Title"] = "Mi resultado vocacional"; var areas = new[]{("Realista",Model.PuntajeR),("Investigador",Model.PuntajeI),("Artístico",Model.PuntajeA),("Social",Model.PuntajeS),("Emprendedor",Model.PuntajeE),("Convencional",Model.PuntajeC)}; var maximo=Math.Max(1,areas.Max(a=>a.Item2));}
<div class="section-heading"><div><span class="section-kicker">TU PERFIL VOCACIONAL</span><h1 class="h2 fw-bold mt-2">Resultados de tu test</h1></div><button class="btn btn-outline-secondary" type="button" onclick="window.print()">Imprimir / Guardar PDF</button></div>
<section class="hero p-4 p-md-5 mb-4" style="min-height:0;display:block"><span class="eyebrow">TU PERFIL DOMINANTE</span><h2 class="display-5 fw-bold mt-3" style="overflow-wrap:anywhere">@Model.PerfilDominante</h2><p class="mb-0">Este resultado resume las áreas con mayor puntuación. No determina por sí solo qué carrera debes estudiar.</p></section>
<h2 class="h4 fw-bold mb-3">Tus intereses por área</h2>
<div class="row g-3 mb-5">@foreach(var a in areas){<div class="col-md-6"><div class="card card-body h-100"><div class="d-flex justify-content-between mb-2"><strong>@a.Item1</strong><span class="text-muted">@a.Item2 puntos</span></div><div class="progress" role="progressbar" aria-label="@a.Item1" aria-valuenow="@a.Item2" aria-valuemin="0" aria-valuemax="@maximo"><div class="progress-bar" style="width:@(100.0*a.Item2/maximo)%"></div></div></div></div>}</div>
<h2 class="h4 fw-bold mb-3">Carreras para investigar</h2>
<div class="row g-3 mb-4">@foreach(var r in Model.Recomendaciones.OrderBy(x=>x.Posicion)){<div class="col-md-4"><article class="feature-card"><span class="section-kicker">OPCIÓN @r.Posicion</span><h3>@r.Carrera?.Nombre</h3><p>@r.Carrera?.Descripcion</p><span class="badge text-bg-light">@r.Carrera?.Tipo</span><p class="small text-muted mt-3 mb-0">Afinidad orientativa: @r.NivelAfinidad%</p></article></div>}</div>
<div class="alert alert-info">Estas recomendaciones son aproximadas y no sustituyen asesoría profesional. Compara planes de estudio, costos, requisitos y oportunidades.</div>
<a class="btn btn-primary" asp-controller="Chat" asp-action="Index">Consultar asistente →</a> <a class="btn btn-outline-primary" asp-controller="Test" asp-action="Historial">Ver historial</a>
