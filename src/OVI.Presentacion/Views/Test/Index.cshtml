@model List<PreguntaRIASEC>
@{ViewData["Title"]="Test RIASEC";}<h1>Test de orientación vocacional</h1><p class="text-muted">Indica cuánto te identifica cada afirmación. Escala: 1 = nada, 5 = muchísimo.</p><div class="alert alert-info">Prototipo académico: el resultado ayuda a explorar intereses y no constituye un diagnóstico ni decide por ti.</div>@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="alert alert-danger"></div>}<form method="post"><div class="progress mb-4" role="progressbar" aria-label="Progreso" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:100%">@Model.Count preguntas</div></div>@for(int i=0;i<Model.Count;i++){<div class="card mb-3"><div class="card-body"><label class="form-label fw-semibold">@(i+1). @Model[i].Enunciado</label><div class="d-flex flex-wrap gap-3">@for(int v=1;v<=5;v++){<label class="form-check"><input class="form-check-input" type="radio" name="respuestas[@Model[i].IdPregunta]" value="@v" required/><span class="form-check-label">@v</span></label>}</div><small class="text-muted">Área: @Model[i].CategoriaRIASEC</small></div></div>}<button class="btn btn-primary btn-lg" type="submit">Calcular mi perfil</button></form>
