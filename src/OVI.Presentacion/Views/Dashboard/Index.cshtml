@model List<DashboardController.PerfilVM>
@{ViewData["Title"]="Dashboard del orientador";}<h1>Panel estadístico</h1><p class="text-muted">Resumen agregado de evaluaciones registradas.</p><div class="row g-3 mb-4"><div class="col-md-4"><div class="card metric"><div class="card-body">Estudiantes activos<div class="display-6">@ViewBag.Estudiantes</div></div></div></div><div class="col-md-4"><div class="card metric"><div class="card-body">Resultados generados<div class="display-6">@ViewBag.Total</div></div></div></div><div class="col-md-4"><div class="card metric"><div class="card-body">Carreras activas<div class="display-6">@ViewBag.Carreras</div></div></div></div></div><h2 class="h4">Distribución por perfil</h2><table class="table table-striped"><thead><tr><th>Perfil RIASEC</th><th>Evaluaciones</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Perfil</td><td>@p.Cantidad</td></tr>}</tbody></table>
