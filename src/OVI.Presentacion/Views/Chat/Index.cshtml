@{
    ViewData["Title"] = "Asistente vocacional";
}

<div class="section-heading">
    <div>
        <span class="section-kicker">PREGUNTA Y EXPLORA</span>
        <h1 class="h2 fw-bold mt-2">Asistente vocacional</h1>
        <p class="text-muted mt-2">
            Descubre nuevas posibilidades para tu futuro profesional.
        </p>
    </div>
</div>

<div class="alert alert-info mb-4" role="status">
    <strong>¡Bienvenido a tu asistente vocacional!</strong>
    <p class="mb-0 mt-2">
        Aquí puedes consultar dudas sobre carreras universitarias,
        carreras técnicas, intereses profesionales, becas y
        opciones académicas. Explora tus posibilidades y encuentra
        información que te ayude a tomar decisiones.
    </p>
</div>

<form method="post" class="card card-body p-4">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="text-danger"
         role="alert">
    </div>

    <label for="mensaje" class="form-label fw-semibold">
        ¿Qué te gustaría saber?
    </label>

    <textarea name="mensaje"
              id="mensaje"
              maxlength="500"
              rows="4"
              class="form-control"
              placeholder="Por ejemplo: ¿Qué carreras se relacionan con mi perfil RIASEC?"
              required>@ViewBag.Pregunta</textarea>

    <div class="d-flex justify-content-between align-items-center mt-3 gap-3">
        <small class="text-muted">
            Máximo 500 caracteres
        </small>

        <button class="btn btn-primary px-4" type="submit">
            Enviar pregunta →
        </button>
    </div>
</form>

@if (ViewBag.Respuesta != null)
{
    <section class="card card-body p-4 mt-4"
             aria-live="polite">

        <span class="section-kicker">
            RESPUESTA DEL ASISTENTE
        </span>

        <p class="mt-3 mb-0"
           style="white-space:pre-line">
            @ViewBag.Respuesta
        </p>

    </section>
}

<div class="card card-body p-4 mt-4">
    <h2 class="h5 fw-bold mb-3">
        ¿No sabes qué preguntar?
    </h2>

    <p class="text-muted mb-2">
        Puedes comenzar con preguntas como:
    </p>

    <ul class="mb-0">
        <li>¿Cómo puedo elegir una carrera universitaria?</li>
        <li>¿Qué significa mi resultado del test RIASEC?</li>
        <li>¿Qué carreras están relacionadas con la tecnología?</li>
        <li>¿Dónde puedo encontrar información sobre becas?</li>
        <li>¿Qué diferencia hay entre una carrera técnica y una universitaria?</li>
    </ul>
</div>

<p class="small text-muted mt-4">
    Este asistente ofrece información orientativa y no sustituye
    el acompañamiento de un orientador profesional.
    No compartas contraseñas ni información sensible.
</p>
