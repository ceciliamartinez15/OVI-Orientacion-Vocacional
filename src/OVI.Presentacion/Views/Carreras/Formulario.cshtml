@using OVI.Presentacion.Models
@model CarreraFormVM
@{ ViewData["Title"] = Model.IdCarrera == 0 ? "Crear carrera" : "Editar carrera"; }
<h1>@(Model.IdCarrera == 0 ? "Crear" : "Editar") carrera</h1>
<form method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="IdCarrera" type="hidden" />
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="150" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" maxlength="500" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" class="form-select">
                @foreach (var t in CarreraFormVM.Tipos) { <option value="@t">@t</option> }
            </select>
            <span asp-validation-for="Tipo" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Institucion" class="form-label"></label>
            <input asp-for="Institucion" class="form-control" maxlength="150" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label d-block">Áreas RIASEC relacionadas</label>
        @foreach (var a in CarreraFormVM.AreasDisponibles)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="Areas" id="area-@a" value="@a" @(Model.Areas.Contains(a) ? "checked" : null) />
                <label class="form-check-label" for="area-@a">@a</label>
            </div>
        }
        <div class="form-text">Con estas áreas se calcula el porcentaje de afinidad en las recomendaciones del test.</div>
        <span asp-validation-for="Areas" class="text-danger d-block"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Estado" class="form-check-input" />
        <label asp-for="Estado" class="form-check-label">Activa</label>
    </div>
    <button class="btn btn-primary">Guardar</button>
    <a class="btn btn-outline-secondary ms-2" asp-action="Index">Cancelar</a>
</form>
