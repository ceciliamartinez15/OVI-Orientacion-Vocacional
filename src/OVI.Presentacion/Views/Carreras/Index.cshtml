@model List<Carrera>
@{ViewData["Title"]="Carreras";}<div class="d-flex justify-content-between align-items-center mb-3"><h1>Catálogo de carreras</h1>@if(User.IsInRole("Admin")){<a class="btn btn-primary" asp-action="Crear">Agregar carrera</a>}</div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Nombre</th><th>Tipo</th><th>Institución</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var c in Model){<tr><td><strong>@c.Nombre</strong><div class="small text-muted">@c.Descripcion</div></td><td>@c.Tipo</td><td>@c.Institucion</td><td>@(c.Estado?"Activa":"Inactiva")</td><td>@if(User.IsInRole("Admin")){<a asp-action="Editar" asp-route-id="@c.IdCarrera">Editar</a> @if(c.Estado){<form asp-action="Eliminar" asp-route-id="@c.IdCarrera" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Desactivar esta carrera?')">Desactivar</button></form>}}</td></tr>}</tbody></table></div>
