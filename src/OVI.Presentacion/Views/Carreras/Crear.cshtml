@model Carrera
@{ViewData["Title"]="Carrera";}<h1>@(Model.IdCarrera==0?"Agregar carrera":"Editar carrera")</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="IdCarrera" type="hidden"/><div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" class="form-select"><option>Universitaria</option><option>Técnica</option></select></div><div class="mb-3"><label asp-for="Institucion" class="form-label"></label><input asp-for="Institucion" class="form-control"/></div><div class="form-check mb-3"><input asp-for="Estado" class="form-check-input"/><label asp-for="Estado" class="form-check-label">Activa</label></div><button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form>
