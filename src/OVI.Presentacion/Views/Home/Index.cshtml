@{
    ViewData["Title"] = "Inicio";
    var sesion = User.Identity?.IsAuthenticated == true;
    var gestion = User.IsInRole("Admin") || User.IsInRole("Orientador");
}
<section class="hero mb-5">
    <div class="hero-content">
        <span class="eyebrow">✦ DESCUBRE LO QUE TE MUEVE</span>
        <h1>Tu futuro empieza <span>conociéndote.</span></h1>
        <p class="hero-lead">Explora tus intereses, descubre tus fortalezas y encuentra carreras que conecten contigo mediante el modelo RIASEC.</p>
        <div class="d-flex flex-wrap gap-3">
            @if (sesion)
            {<a class="btn btn-primary btn-lg" asp-controller="Test" asp-action="Index">Realizar mi test <span aria-hidden="true">→</span></a>}
            else
            {<a class="btn btn-primary btn-lg" asp-controller="Cuenta" asp-action="Registro">Empezar gratis <span aria-hidden="true">→</span></a>}
            <a class="btn btn-outline-dark btn-lg" asp-controller="Carreras" asp-action="Index">Explorar carreras</a>
        </div>
        <p class="hero-note">✓ Test guiado &nbsp; ✓ Resultados personales &nbsp; ✓ Recomendaciones orientativas</p>
    </div>
    <div class="hero-visual" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="visual-core">✦</div><span class="floating-pill pill-one">Creatividad</span><span class="floating-pill pill-two">Intereses</span><span class="floating-pill pill-three">Tu camino</span></div>
</section>
@if (sesion && gestion)
{
    <div class="section-heading"><div><span class="section-kicker">PANEL DE GESTIÓN</span><h2>Resumen del sistema</h2></div><a asp-controller="Dashboard" asp-action="Index">Ver estadísticas →</a></div>
    <div class="row g-3 mb-5">
        <div class="col-md-4"><div class="metric-card"><span>Estudiantes activos</span><strong>@ViewBag.Estudiantes</strong><small>Usuarios con acceso</small></div></div>
        <div class="col-md-4"><div class="metric-card"><span>Evaluaciones finalizadas</span><strong>@ViewBag.Evaluaciones</strong><small>Tests completados</small></div></div>
        <div class="col-md-4"><div class="metric-card"><span>Carreras en catálogo</span><strong>@ViewBag.Carreras</strong><small>Opciones disponibles</small></div></div>
    </div>
}
else if (sesion)
{
    <div class="section-heading"><div><span class="section-kicker">MI ESPACIO</span><h2>Mi orientación vocacional</h2></div><a asp-controller="Test" asp-action="Historial">Mi historial →</a></div>
    <div class="row g-3 mb-5">
        <div class="col-md-6"><div class="metric-card"><span>Mis evaluaciones finalizadas</span><strong>@ViewBag.MisEvaluaciones</strong><small>Tu progreso personal</small></div></div>
        <div class="col-md-6"><div class="metric-card"><span>Mi último perfil RIASEC</span><div class="profile-value">@(ViewBag.UltimoPerfil ?? "Aún no has realizado el test")</div>@if (ViewBag.UltimoResultadoId != null){<a asp-controller="Test" asp-action="Resultado" asp-route-id="@ViewBag.UltimoResultadoId">Ver mis recomendaciones →</a>}</div></div>
    </div>
}
<div class="section-heading"><div><span class="section-kicker">A TU RITMO</span><h2>Todo lo que necesitas para explorar</h2></div></div>
<div class="row g-4">
    <div class="col-md-4"><article class="feature-card"><span class="feature-icon">◎</span><h3>Test de intereses</h3><p>Responde afirmaciones sencillas y descubre tus áreas RIASEC más destacadas.</p><a asp-controller="Test" asp-action="Index">Hacer el test →</a></article></div>
    <div class="col-md-4"><article class="feature-card"><span class="feature-icon">✧</span><h3>Asistente vocacional</h3><p>Resuelve dudas sobre tus opciones y conoce nuevas posibilidades.</p><a asp-controller="Chat" asp-action="Index">Consultar asistente →</a></article></div>
    <div class="col-md-4"><article class="feature-card"><span class="feature-icon">▤</span><h3>Catálogo de carreras</h3><p>Conoce carreras universitarias y técnicas para seguir investigando.</p><a asp-controller="Carreras" asp-action="Index">Ver carreras →</a></article></div>
</div>
