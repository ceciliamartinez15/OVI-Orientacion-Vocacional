@model OVI.Presentacion.Models.RegistroVM
@{ViewData["Title"]="Registro";}
<h1>Crear cuenta de estudiante</h1><form method="post" class="col-lg-6"><div asp-validation-summary="All" class="text-danger"></div>
@foreach(var campo in new[]{"Nombre","Apellido","Correo","Contrasena","ConfirmarContrasena"}){<div class="mb-3"><label class="form-label" for="@campo">@campo</label><input class="form-control" id="@campo" name="@campo" type="@(campo.Contains("Contrasena")?"password":campo=="Correo"?"email":"text")" required maxlength="150" /></div>}
<button class="btn btn-primary">Registrarme</button> <a asp-action="Login">Ya tengo cuenta</a></form>
