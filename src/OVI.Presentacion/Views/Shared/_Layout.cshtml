<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#6B6056" />
    <title>@ViewData["Title"] · VocalO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@800;900&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/faq-widget.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column">
<a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
<nav class="navbar navbar-expand-lg navbar-dark ovi-nav" aria-label="Navegación principal">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><img class="brand-avatar" src="~/img/robot-cara.png" alt="" /> VocalO <span class="brand-sub">Orientación Vocacional</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Test" asp-action="Index">Test RIASEC</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Test" asp-action="Historial">Mi historial</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Chatbot" asp-action="Contextual">Asistente</a></li>
                @if (User.IsInRole("Admin") || User.IsInRole("Orientador"))
                {<li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Estadísticas</a></li>}
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Preguntas" asp-action="Index">Preguntas</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Instituciones" asp-action="Index">Instituciones</a></li>
                }
                <li class="nav-item"><form asp-controller="Cuenta" asp-action="Salir" method="post"><button type="submit" class="btn btn-outline-light btn-sm ms-lg-2">Salir · @User.Identity.Name</button></form></li>
            }
            else
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Ingresar</a></li>
                <li class="nav-item"><a class="btn btn-light btn-sm ms-lg-2" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a></li>
            }
        </ul></div>
    </div>
</nav>
<main id="contenido" class="container py-4 py-md-5 flex-grow-1">@RenderBody()</main>
<footer class="ovi-footer py-4"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>VocalO · Orientación Vocacional</span><span>Los resultados son orientativos, no diagnósticos.</span></div></footer>

<div id="faq-widget" class="fw" data-url-opciones="@Url.Action("FaqOpciones", "Chatbot")" data-url-preguntar="@Url.Action("PreguntarFaq", "Chatbot")">
    <section id="fw-panel" class="fw-panel" role="dialog" aria-labelledby="fw-titulo">
        <header class="fw-head">
            <img class="fw-head-avatar" src="~/img/robot-cara.png" alt="" />
            <div class="fw-head-texto">
                <p id="fw-titulo" class="fw-titulo">Preguntas frecuentes</p>
                <p class="fw-sub">Saviox · elige una pregunta</p>
            </div>
            <button type="button" id="fw-cerrar" class="fw-cerrar" aria-label="Cerrar preguntas frecuentes">&times;</button>
        </header>
        <div id="fw-mensajes" class="fw-mensajes" aria-live="polite"></div>
        <form id="fw-form" class="fw-form" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="text" id="fw-input" class="fw-input" maxlength="500" placeholder="O escribe tu pregunta" aria-label="Escribe tu pregunta" />
            <button type="submit" class="fw-enviar" aria-label="Enviar">&#10148;</button>
        </form>
        <p class="fw-aviso">Información orientativa. No compartas contraseñas ni datos sensibles.</p>
    </section>
    <button type="button" id="fw-boton" class="fw-boton" aria-expanded="false" aria-controls="fw-panel" aria-label="Abrir preguntas frecuentes">
        <img src="~/img/robot-cara.png" alt="" />
        <span class="fw-boton-x" aria-hidden="true">&times;</span>
        <span class="fw-etiqueta" aria-hidden="true">Preguntas frecuentes</span>
    </button>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/faq-widget.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
