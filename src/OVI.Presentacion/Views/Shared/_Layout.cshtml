<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#112b46" />
    <title>@ViewData["Title"] · OVI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
<nav class="navbar navbar-expand-lg navbar-dark ovi-nav" aria-label="Navegación principal">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">✦</span> OVI <span class="brand-sub">Orientación Vocacional</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
            <li class="nav-item"><a class="nav-link" asp-controller="Carreras" asp-action="Index">Carreras</a></li>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Test" asp-action="Index">Test RIASEC</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Test" asp-action="Historial">Mi historial</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Chat" asp-action="Index">Asistente</a></li>
                @if (User.IsInRole("Admin") || User.IsInRole("Orientador"))
                {<li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Estadísticas</a></li>}
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Preguntas" asp-action="Index">Preguntas</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Instituciones" asp-action="Index">Instituciones</a></li>
                }
                <li class="nav-item"><form asp-controller="Cuenta" asp-action="Salir" method="post"><button type="submit" class="btn btn-outline-light btn-sm ms-lg-2">Salir · @User.Identity.Name</button></form></li>
            }
            else
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Ingresar</a></li>
                <li class="nav-item"><a class="btn btn-light btn-sm ms-lg-2" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a></li>
            }
        </ul></div>
    </div>
</nav>
<main id="contenido" class="container py-4 py-md-5">@RenderBody()</main>
<footer class="ovi-footer py-4 mt-5"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>✦ OVI · Orientación Vocacional</span><span>Proyecto académico · Resultados orientativos, no diagnósticos</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
