@model PreguntaRIASEC
<h1>@(Model.IdPregunta==0?"Crear":"Editar") pregunta</h1><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="IdPregunta" type="hidden"/><div class="mb-3"><label asp-for="Enunciado"></label><textarea asp-for="Enunciado" class="form-control" maxlength="500" required></textarea><span asp-validation-for="Enunciado" class="text-danger"></span></div><div class="mb-3"><label asp-for="CategoriaRIASEC"></label><select asp-for="CategoriaRIASEC" class="form-select">@foreach(var cat in new[]{"Realista","Investigador","Artistico","Social","Emprendedor","Convencional"}){<option value="@cat">@cat</option>}</select></div><div class="mb-3"><label asp-for="Valor"></label><input asp-for="Valor" type="number" min="1" max="5" class="form-control"/><span asp-validation-for="Valor" class="text-danger"></span></div><label><input asp-for="Estado"/> Activa</label><div class="mt-3"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary ms-2" asp-action="Index">Cancelar</a></div></form>
