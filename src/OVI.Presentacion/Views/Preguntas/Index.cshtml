@model List<PreguntaRIASEC>
<h1>Preguntas RIASEC</h1><a class="btn btn-primary mb-3" asp-action="Crear">Agregar pregunta</a><table class="table table-striped"><thead><tr><th>Pregunta</th><th>Área</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Enunciado</td><td>@x.CategoriaRIASEC</td><td>@(x.Estado?"Activa":"Inactiva")</td><td><div class="d-flex align-items-center gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@x.IdPregunta">Editar</a><form asp-action="Estado" asp-route-id="@x.IdPregunta" method="post" class="d-inline"><button class="btn btn-sm @(x.Estado?"btn-outline-danger":"btn-outline-success")">@(x.Estado?"Desactivar":"Activar")</button></form></div></td></tr>}</tbody></table>
