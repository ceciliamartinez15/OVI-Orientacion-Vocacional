# Copiar a .env y cambiar la contraseña (12+ caracteres, mayúsculas, minúsculas, números y símbolos).
MSSQL_SA_PASSWORD=CAMBIAR_EstaClave123!
# Opcional: crear un administrador NUEVO al iniciar por primera vez. No eleva usuarios existentes.
OVI_ADMIN_EMAIL=
OVI_ADMIN_PASSWORD=
# Opcional: chat con IA (endpoint HTTPS compatible con Chat Completions, autenticación Bearer).
# Si IA_ENDPOINT / IA_MODEL quedan vacíos se usa Groq (openai/gpt-oss-20b). Solo hace falta IA_API_KEY.
IA_API_KEY=
IA_ENDPOINT=
IA_MODEL=
